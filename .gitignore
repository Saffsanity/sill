.build/
.swiftpm/
xcuserdata/
*.xcuserstate
DerivedData/
.DS_Store

# Signing and notary keys, certificates exported with their keys, provisioning profiles and
# keychains: never in the repository (docs/release-checklist.md keeps them outside it).
*.p12
*.p8
AuthKey_*
*.pem
*.mobileprovision
*.provisionprofile
*.keychain
*.keychain-db

# The sizzle reel's renders (design/reel, over a gigabyte): kept out of git.
design/reel/

# The site's films, the teaser and the whole film: GitHub Pages serves them, and the README plays
# the teaser from an upload. They are never committed here, so clones stay small; their posters are.
# docs/release-checklist.md, "The film on the site and the README".
site/media/*.mp4
