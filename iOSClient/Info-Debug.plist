<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iPhones with ProMotion hold app rendering at 60 Hz unless the app asks; the stream is 120 fps
	     on those panels, so ask. iPads ignore this key. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Export compliance: Sill uses no encryption but Apple's own, so uploads, TestFlight builds
	     included, skip the encryption questions. Look again before adding cipher code or a crypto
	     library of Sill's own (docs/app-store-metadata.md section 6). -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Finds your Mac on the local network.</string>
	<!-- DEBUG ONLY: Info.plist (the Release configuration's) plus `_silltest._tcp`, which the Debug
	     build browses for with -SillServiceType _silltest._tcp: the simulator refuses a browse for
	     a type this list does not declare (-65555 NoAuth, docs/home-pairing-plan.md, H0's P5). A
	     key added to Info.plist goes here too; nothing else may differ. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_sill._tcp</string>
		<string>_silltest._tcp</string>
	</array>
	<!-- Picture in Picture (docs/picture-in-picture-plan.md): AVKit takes a picture into iOS's floating
	     window, and keeps the app running while it shows, only with the audio background mode (Xcode's
	     "Audio, AirPlay, and Picture in Picture"). Nothing else uses it: Sill's sound still stops in the
	     background unless that window plays it (PictureInPicturePolicy.soundHeard). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Add a Mac: the embedded scanner reads the pairing code the Mac shows. -->
	<key>NSCameraUsageDescription</key>
	<string>Sill scans the code on your Mac to pair with it.</string>
	<!-- sill://pair links from the Camera or Messages. Never acted on without a confirmation, since
	     another app could claim the scheme too; the in-app scanner is the main path. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>me.saffer.sill.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sill</string>
			</array>
		</dict>
	</array>
	<!-- Files and photos (docs/files-plan.md §8.3): Sill among the apps of another app's share sheet for a file
	     of any type (Open In, the Files app's Share), which it sends to the Mac it is connected to once the person
	     says Send. Rank Alternate: never the default app for any type. With LSSupportsOpeningDocumentsInPlace iOS
	     hands over the original, read in place under its security scope, rather than a copy in Documents/Inbox. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.item</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Files from the Mac (docs/files-plan.md §8.4): Sill's Documents shows in the Files app as On My iPad › Sill,
	     where they land in From ‹Mac› (SillDocuments); the recordings of #284 share this change. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<!-- Save to Photos (PhotoSaver): add-only access, never read access, asked the first time. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Sill saves photos and videos from your Mac to your library.</string>
</dict>
</plist>
