            "value": "文字大小"
          }
        }
      }
    },
    "Text you copy here can be pasted on a connected iPhone or iPad, and text sent from one with Paste becomes this Mac’s.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这里拷贝的文本可以粘贴到已连接的 iPhone 或 iPad 上；从设备通过“粘贴”发送的文本也会进入这台 Mac 的剪贴板。"
          }
        }
      }
    },
    "Text you copy on %@ is ready to paste on this %@. To paste on %@, copy text here and tap Paste: it goes where %@’s cursor is. With Paste on %@ Right Away off, Paste only puts it on %@’s clipboard.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Text you copy on %1$@ is ready to paste on this %2$@. To paste on %3$@, copy text here and tap Paste: it goes where %4$@’s cursor is. With Paste on %5$@ Right Away off, Paste only puts it on %6$@’s clipboard."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在 %1$@ 上拷贝的文本可以直接粘贴到这台 %2$@ 上。要粘贴到 %3$@，在这里拷贝文本并轻点“粘贴”：文本会出现在 %4$@ 的光标处。如果关闭“立即在 %5$@ 上粘贴”，“粘贴”只会把文本放到 %6$@ 的剪贴板。"
          }
        }
      }
    },
    "Text you copy on %@ is ready to paste on this %@. To paste on %@, copy text here, tap Paste, then press ⌘V there.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Text you copy on %1$@ is ready to paste on this %2$@. To paste on %3$@, copy text here, tap Paste, then press ⌘V there."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在 %1$@ 上拷贝的文本可以直接粘贴到这台 %2$@ 上。要粘贴到 %3$@，在这里拷贝文本，轻点“粘贴”，然后在那里按 ⌘V。"
          }
        }
      }
    },
    "That code didn’t work. Check the code on your Mac. %lld tries left.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对码不对。请核对你 Mac 上的配对码。还剩 %lld 次。"
          }
        }
      }
    },
    "That code didn’t work. Check the code on your Mac. 1 try left.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对码不对。请核对你 Mac 上的配对码。还剩 1 次。"
          }
        }
      }
    },
    "That code expired. Tap %@ for a new one.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对码已过期。轻点 %@ 获取新的配对码。"
          }
        }
      }
    },
    "That code has a typo. Check it against your Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对码有输入错误。请对照你的 Mac 检查。"
          }
        }
      }
    },
    "That code no longer works. On the Mac, choose Pair iPhone or iPad… in the Sill menu, then tap %@ again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个配对码已失效。请在 Mac 的 Sill 菜单中选择“配对 iPhone 或 iPad…”，然后再轻点 %@。"
          }
        }
      }
    },
    "That doesn’t look like an address. Try 100.101.102.103 or mac.example.net.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这看起来不像地址。可以试试 100.101.102.103 或 mac.example.net。"
          }
        }
      }
    },
    "That’s not a Sill code.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是 Sill 的配对码。"
          }
        }
      }
    },
    "The Mac": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac"
          }
        }
      }
    },
    "The Mac at %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位于 %@ 的 Mac"
          }
        }
      }
    },
    "The Mac didn’t answer. Open the menu again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 没有应答。请重新打开菜单。"
          }
        }
      }
    },
    "The Mac didn’t answer. Try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 没有应答。请重试。"
          }
        }
      }
    },
    "The app isn’t responding.": {
