{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    " · ": {},
    "%@ answered, but Sill isn’t accepting remote connections there. Check that Sill is open and Remote Access is on. If you changed its port, connect at home once.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ answered, but Sill isn’t accepting remote connections there. Check that Sill is open and Remote Access is on. If you changed its port, connect at home once."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已响应，但那里的 Sill 不接受远程连接。请确认 Sill 已打开且“远程访问”已开启。如果更改过端口，请在家中连接一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已回應，但該處的 Sill 不接受遠端連線。請確認 Sill 已開啟且「遠端存取」已開啟。如果更改過連接埠，請在家中連線一次。"
          }
        }
      }
    },
    "%@ closed the connection. Sill will reconnect when it can.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ closed the connection. Sill will reconnect when it can."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已关闭连接。Sill 会在可以连接时重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已關閉連線。Sill 會在可以連線時重新連線。"
          }
        }
      }
    },
    "%@ closed the connection. Tap it to try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ closed the connection. Tap it to try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已关闭连接。轻点它以重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已關閉連線。點一下它以重試。"
          }
        }
      }
    },
    "%@ didn’t answer at %@. If your home’s internet address changed, connect at home once to update it, or add an address name on the Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ didn’t answer at %@. If your home’s internet address changed, connect at home once to update it, or add an address name on the Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 未在 %2$@ 响应。如果家中的互联网地址已更改，请在家中连接一次以更新地址，或在 Mac 上添加一个域名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 未在 %2$@ 回應。如果家中的網際網路位址已更改，請在家中連線一次以更新位址，或在 Mac 上加入一個網域名稱。"
          }
        }
      }
    },
    "%@ didn’t answer. Check that Sill is open on it, then tap it again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ didn’t answer. Check that Sill is open on it, then tap it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未响应。请确认它已打开 Sill，然后再次轻点它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未回應。請確認它已開啟 Sill，然後再點一下它。"
          }
        }
      }
    },
    "%@ didn’t answer. It may be asleep, or %@ may be off on the Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ didn’t answer. It may be asleep, or %@ may be off on the Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 未响应。它可能已进入睡眠，或 Mac 上的 %2$@ 未开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 未回應。它可能已進入睡眠，或 Mac 上的 %2$@ 未開啟。"
          }
        }
      }
    },
    "%@ didn’t answer. It may be asleep.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ didn’t answer. It may be asleep."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未响应。它可能已进入睡眠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未回應。它可能已進入睡眠。"
          }
        }
      }
    },
    "%@ didn’t answer. Try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ didn’t answer. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未响应。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未回應。請重試。"
          }
        }
      }
    },
    "%@ didn’t show a code by itself. On the Mac, choose Pair iPhone or iPad… in the Sill menu.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ didn’t show a code by itself. On the Mac, choose Pair iPhone or iPad… in the Sill menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有自动显示配对码。请在 Mac 的 Sill 菜单中选择“配对 iPhone 或 iPad…”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 沒有自動顯示配對碼。請在 Mac 的 Sill 選單中選擇「配對 iPhone 或 iPad⋯」。"
          }
        }
      }
    },
    "%@ didn’t show a code. On the Mac, choose Pair iPhone or iPad… in the Sill menu, then tap %@ again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ didn’t show a code. On the Mac, choose Pair iPhone or iPad… in the Sill menu, then tap %@ again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 没有显示配对码。请在 Mac 的 Sill 菜单中选择“配对 iPhone 或 iPad…”，然后再次轻点 %2$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 沒有顯示配對碼。請在 Mac 的 Sill 選單中選擇「配對 iPhone 或 iPad⋯」，然後再點一下 %2$@。"
          }
        }
      }
    },
    "%@ disconnected. It will reconnect when the Mac is back.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ disconnected. It will reconnect when the Mac is back."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已断开连接。Mac 恢复可用后会重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已中斷連線。Mac 恢復可用後會重新連線。"
          }
        }
      }
    },
    "%@ disconnected. Sill will reconnect when it can reach it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ disconnected. Sill will reconnect when it can reach it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已断开连接。Sill 会在可以访问它时重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已中斷連線。Sill 會在可以連上它時重新連線。"
          }
        }
      }
    },
    "%@ has a new key since this %@ paired. Tap it to pair again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has a new key since this %@ paired. Tap it to pair again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的密钥与这台 %2$@ 配对时不同。轻点它以重新配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的金鑰與這台 %2$@ 配對時不同。點一下它以重新配對。"
          }
        }
      }
    },
    "%@ is already serving 8 devices.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is already serving 8 devices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已在为 8 台设备提供串流。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已在為 8 台裝置提供串流。"
          }
        }
      }
    },
    "%@ is saved. Tap it to connect.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is saved. Tap it to connect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已保存。轻点它以连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已儲存。點一下它以連線。"
          }
        }
      }
    },
    "%@ is showing a code now.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is showing a code now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 现在已显示配对码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 現在已顯示配對碼。"
          }
        }
      }
    },
    "%@ is showing a code. Point this %@ at it.": {
      "comment": "Arguments are the external Mac name and iPhone/iPad.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is showing a code. Point this %@ at it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已显示配对码。请用这台 %2$@ 对准它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已顯示配對碼。請用這台 %2$@ 對準它。"
          }
        }
      }
    },
    "%@ isn’t answering. It may be asleep. Sill keeps trying, or tap it to try now.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn’t answering. It may be asleep. Sill keeps trying, or tap it to try now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未响应。它可能已进入睡眠。Sill 会继续尝试，也可以轻点它立即重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未回應。它可能已進入睡眠。Sill 會繼續嘗試，也可以點一下它立即重試。"
          }
        }
      }
    },
    "%@ isn’t pairing right now. On your Mac, choose Pair iPhone or iPad… first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn’t pairing right now. On your Mac, choose Pair iPhone or iPad… first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 目前未在配对。请先在 Mac 上选择“配对 iPhone 或 iPad…”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 目前未在配對。請先在 Mac 上選擇「配對 iPhone 或 iPad⋯」。"
          }
        }
      }
    },
    "%@ lets devices connect without pairing. Pair this %@ once to keep connecting if that changes, and to reach %@ away from home while Remote Access is on. %@ shows a code; scan it with this %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lets devices connect without pairing. Pair this %@ once to keep connecting if that changes, and to reach %@ away from home while Remote Access is on. %@ shows a code; scan it with this %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 允许设备不经配对直接连接。将这台 %2$@ 配对一次，之后即使该设置改变，也能继续连接；开启“远程访问”后，还能从外面访问 %3$@。%4$@ 会显示配对码，请用这台 %5$@ 扫描。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 允許裝置不經配對直接連線。將這台 %2$@ 配對一次，之後即使該設定改變，也能繼續連線；開啟「遠端存取」後，還能在外連上 %3$@。%4$@ 會顯示配對碼，請用這台 %5$@ 掃描。"
          }
        }
      }
    },
    "%@ looks off on this %@. Turn it on, then tap %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ looks off on this %@. Turn it on, then tap %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 %2$@ 上的 %1$@ 似乎未开启。请开启它，然后轻点 %3$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 %2$@ 上的 %1$@ 似乎未開啟。請開啟它，然後點一下 %3$@。"
          }
        }
      }
    },
    "%@ no longer accepts this %@. Pair it again from Sill’s Settings on the Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no longer accepts this %@. Pair it again from Sill’s Settings on the Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已不再接受这台 %2$@。请从 Mac 上 Sill 的“设置”重新配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已不再接受這台 %2$@。請從 Mac 上 Sill 的「設定」重新配對。"
          }
        }
      }
    },
    "%@ now asks devices to pair. Tap it to pair this %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ now asks devices to pair. Tap it to pair this %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 现在要求设备配对。轻点它以配对这台 %2$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 現在要求裝置配對。點一下它以配對這台 %2$@。"
          }
        }
      }
    },
    "%@ quit Sill. This %@ reconnects when it’s back.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ quit Sill. This %@ reconnects when it’s back."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已退出 Sill。Sill 再次运行后，这台 %2$@ 会重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已結束 Sill。Sill 再次執行後，這台 %2$@ 會重新連線。"
          }
        }
      }
    },
    "%@ removed this %@. Tap it to pair again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ removed this %@. Tap it to pair again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已移除这台 %2$@。轻点它以重新配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已移除這台 %2$@。點一下它以重新配對。"
          }
        }
      }
    },
    "%@ removed this %@. To use it again, pair it again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ removed this %@. To use it again, pair it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已移除这台 %2$@。请重新配对以再次使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已移除這台 %2$@。請重新配對以再次使用。"
          }
        }
      }
    },
    "%@ runs an older Sill. Update Sill on the Mac to connect.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ runs an older Sill. Update Sill on the Mac to connect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上的 Sill 版本较旧。请更新 Mac 上的 Sill 后再连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上的 Sill 版本較舊。請更新 Mac 上的 Sill 後再連線。"
          }
        }
      }
    },
    "%@ stopped accepting connections from the internet. Connect through your VPN.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stopped accepting connections from the internet. Connect through your VPN."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已停止接受来自互联网的连接。请通过 VPN 连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已停止接受來自網際網路的連線。請透過 VPN 連線。"
          }
        }
      }
    },
    "%@ stopped pairing after too many wrong codes. Choose Pair iPhone or iPad… on your Mac for a new code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stopped pairing after too many wrong codes. Choose Pair iPhone or iPad… on your Mac for a new code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 因配对码错误次数过多而停止配对。请在 Mac 上选择“配对 iPhone 或 iPad…”以获取新配对码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 因配對碼錯誤次數過多而停止配對。請在 Mac 上選擇「配對 iPhone 或 iPad⋯」以取得新配對碼。"
          }
        }
      }
    },
    "%@ stopped pairing after too many wrong codes. On the Mac, choose Pair iPhone or iPad… in the Sill menu, then tap %@ again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stopped pairing after too many wrong codes. On the Mac, choose Pair iPhone or iPad… in the Sill menu, then tap %@ again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 因配对码错误次数过多而停止配对。请在 Mac 的 Sill 菜单中选择“配对 iPhone 或 iPad…”，然后再次轻点 %2$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 因配對碼錯誤次數過多而停止配對。請在 Mac 的 Sill 選單中選擇「配對 iPhone 或 iPad⋯」，然後再點一下 %2$@。"
          }
        }
      }
    },
    "%@ times": {},
