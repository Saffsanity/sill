    },
    "Update Sill on %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@ 上更新 Sill"
          }
        }
      }
    },
    "Update Sill on %@ to change these from here.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@ 上更新 Sill 后才能从这里更改这些设置。"
