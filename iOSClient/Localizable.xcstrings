        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 没有响应。"
          }
        }
      }
    },
    "The keyboard key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘键"
          }
        }
      }
    },
    "The last button in the bar.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "栏中的最后一个按钮。"
          }
        }
      }
    },
    "The last button in the row under the picture.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画面下方那一行的最后一个按钮。"
          }
        }
      }
    },
    "The link can’t carry %@, which %@ keeps while a device at home is connected.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The link can’t carry %1$@, which %2$@ keeps while a device at home is connected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接带宽跟不上 %1$@；有一台在家的设备已连接时，%2$@ 会保持这个画质。"
          }
        }
      }
    },
    "The link can’t carry %@. %@ is recommended.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The link can’t carry %1$@. %2$@ is recommended."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接带宽跟不上 %1$@。建议使用 %2$@。"
          }
        }
      }
    },
    "The link can’t keep up with %@. Lower it in Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接跟不上 %@。请在设置中调低。"
          }
        }
      }
    },
    "The link to %@ can’t keep up.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到 %@ 的连接跟不上。"
          }
        }
      }
    },
    "The link to %@ is too slow for a steady picture, even at Low.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到 %@ 的连接太慢，即使用“低”画质画面也不稳定。"
          }
        }
      }
    },
    "The menus changed. Open the menu again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单已改变。请重新打开菜单。"
          }
        }
      }
    },
    "The picture is arriving slowly from %@. Choose Low quality or Standard resolution.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自 %@ 的画面到达得很慢。请选择“低”画质或“标准”分辨率。"
          }
        }
      }
    },
    "The picture of %@ fills the screen below the bar.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的画面占满栏下方的屏幕。"
          }
        }
      }
    },
    "The picture of %@ fills the top half of the screen.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的画面占据屏幕上半部分。"
          }
        }
      }
    },
    "The picture of %@ is at the top of the screen.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的画面在屏幕顶部。"
          }
        }
      }
    },
    "The window you pick moves onto an invisible display on %@ while it streams, so it keeps updating when covered.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你选的窗口在串流时会移到 %@ 上一个看不见的显示器，这样被挡住时也会继续更新。"
          }
        }
      }
    },
    "Then press ⌘V there.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "然后在那里按 ⌘V。"
          }
        }
      }
    },
    "This %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 %@"
          }
        }
      }
    },
    "This %@ can’t look up %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This %1$@ can’t look up %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 %1$@ 无法查找 %2$@。"
          }
        }
      }
    },
    "This %@ can’t look up %@. Is Tailscale on?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This %1$@ can’t look up %2$@. Is Tailscale on?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 %1$@ 无法查找 %2$@。Tailscale 开着吗？"
          }
        }
      }
    },
    "This %@ couldn’t make its key (%@).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This %1$@ couldn’t make its key (%2$@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 %1$@ 无法生成它的密钥（%2$@）。"
          }
        }
      }
    },
    "This %@ has no key for %@. Pair it again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This %1$@ has no key for %2$@. Pair it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 %1$@ 没有 %2$@ 的密钥。请重新配对。"
          }
        }
      }
    },
    "This %@ is connected directly: turning this off disconnects it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 %@ 正在直接连接：关闭此项会断开它。"
          }
        }
      }
    },
    "This %@ is muted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 %@ 已静音。"
          }
        }
      }
    },
    "This %@ shows up to %lld fps.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This %1$@ shows up to %2$lld fps."
          }
