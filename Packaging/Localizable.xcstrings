    "Can’t pair while port %lld is in use.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t pair while port %lld is in use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口 %lld 正被占用，暂时无法配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接埠 %lld 正在使用中，暫時無法配對。"
          }
        }
      }
    },
    "Can’t pair: remote access couldn’t start. Sill tries again every 30 seconds.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t pair: remote access couldn’t start. Sill tries again every 30 seconds."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法配对：远程访问未能启动。Sill 每 30 秒会重试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法配對：遠端存取無法啟動。Sill 每 30 秒會再試一次。"
          }
        }
      }
    },
    "Can’t scan? Tap Enter Code Instead, and type:": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t scan? Tap Enter Code Instead, and type:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法扫描？轻点“改为输入配对码”，然后输入："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法掃描？點一下「改為輸入配對碼」，然後輸入："
          }
        }
      }
    },
    "Change It in Sharing Settings…": {},
