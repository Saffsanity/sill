        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 iPhone 或 iPad 在这台 Mac 上点按、滚动和输入，并允许 Sill 移动串流窗口及调整其大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 iPhone 或 iPad 在這部 Mac 上點按、捲動及輸入，並允許 Sill 移動串流視窗及調整其大小。"
          }
        }
