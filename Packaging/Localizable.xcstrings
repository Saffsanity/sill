        }
      }
    },
    "Point it at this code, or tap Enter Code Instead and type the code.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对准这个配对码，或轻点“改为输入配对码”并输入配对码。"
