    "Port %@ is in use by another app, so devices can’t reach this Mac remotely. Sill tries again every 30 seconds.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口 %@ 被其他 App 占用，因此设备无法远程访问这台 Mac。Sill 每 30 秒重试一次。"
          }
        }
      }
    },
    "Port %@ is in use by another app.": {
