    "Set Sill to Allow under Paste from Other Apps in Privacy & Security. Text a device sends with Paste still arrives.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“隐私与安全性”的“从其他 App 粘贴”中将 Sill 设为“允许”。设备通过“粘贴”发送的文本仍会送达。"
          }
        }
      }
    },
    "Settings…": {
