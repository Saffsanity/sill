{
  "sourceLanguage": "en",
  "strings": {
    "%@ %@ asked to pair.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@的 %1$@ 请求配对。"
          }
        }
      }
    },
    "%@ Connected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已连接"
          }
        }
      }
    },
    "%@ Mbps": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Mbps"
          }
        }
      }
    },
    "%@ Wants to Pair": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 请求配对"
          }
        }
      }
    },
    "%@ and %@": {
      "comment": "The last two items of a list",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@和%2$@"
          }
        }
      }
    },
    "%@ and %@ need the USB cable or very fast Wi‑Fi; if the picture lags, step down.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@和%2$@需要 USB 线或非常快的 Wi‑Fi；如果画面卡顿，请调低一档。"
          }
        }
      }
    },
    "%@ and its executable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 及其可执行文件"
          }
        }
      }
    },
    "%@ asked to pair.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 请求配对。"
          }
        }
      }
    },
    "%@ can no longer connect.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已无法再连接。"
          }
        }
      }
    },
    "%@ can no longer connect. To use it again, pair it again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已无法再连接。要再次使用，请重新配对。"
          }
        }
      }
    },
    "%@ couldn’t be read": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取%@"
          }
        }
      }
    },
    "%@ couldn’t be saved": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存%@"
          }
        }
      }
    },
    "%@ is paired with this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已与这台 Mac 配对。"
          }
        }
      }
    },
    "%@ is still paired: Sill couldn’t update the keychain (%@). Try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 仍处于配对状态：Sill 无法更新钥匙串（%2$@）。请再试一次。"
          }
        }
      }
    },
    "%@ — %lld Mbps": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — %2$lld Mbps"
          }
        }
      }
    },
    "%@ — Not connected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 未连接"
          }
        }
      }
    },
    "%@. Quit and reopen Sill to try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。退出并重新打开 Sill 后再试。"
          }
        }
      }
    },
    "%@×%@ · %@ · %lld Mbps": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@×%2$@ · %3$@ · %4$lld Mbps"
          }
        }
      }
    },
    "%lld": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          }
        }
      }
    },
    "%lld Devices": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 台设备"
          }
        }
      }
    },
    "%lld fps · frame age %@ · RTT %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld fps · 帧延迟 %2$@ · RTT %3$@"
          }
        }
      }
    },
    "%lld fps, still": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fps，画面静止"
          }
        }
      }
    },
    "%lld fps, the link can’t carry %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld fps，当前链路带不动“%2$@”"
          }
        }
      }
    },
    "%lld ms": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 毫秒"
          }
        }
      }
    },
    "%lld of %lld fps": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld / %2$lld fps"
          }
        }
      }
    },
    ", ": {
      "comment": "Between the items of a list but the last two",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "、"
          }
        }
      }
    },
    "120 fps": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "120 fps"
          }
        }
      }
    },
    "60 fps": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "60 fps"
          }
        }
      }
    },
    "A code is showing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在显示配对码。"
          }
        }
      }
    },
    "A device": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一台设备"
          }
        }
      }
    },
    "A paired device can see and control this Mac on your network, nearby, and from afar while Remote Access is on. If one is lost, remove it here.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已配对的设备可以在你的网络中、在附近，以及在远程访问打开时从远处查看并控制这台 Mac。如果设备丢失，请在这里移除它。"
          }
        }
      }
    },
    "A paired device can see and control this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已配对的设备可以查看并控制这台 Mac。"
          }
        }
      }
    },
    "A wrong code came from %@. %lld tries left.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 输入了错误的配对码。还剩 %2$lld 次机会。"
          }
        }
      }
    },
    "A wrong code came from %@. 1 try left.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 输入了错误的配对码。还剩 1 次机会。"
          }
        }
      }
    },
    "About Sill": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于 Sill"
          }
        }
      }
    },
    "Access belongs to Sill itself. Access you gave Terminal for the SillHost command-line tool doesn’t carry over.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "权限属于 Sill 本身。你为 SillHost 命令行工具授予“终端”的权限不会沿用到这里。"
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能"
          }
        }
      }
    },
    "Accessibility: Allowed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能：已允许"
          }
        }
      }
    },
    "Accessibility: Not Allowed…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能：未允许…"
          }
        }
      }
    },
    "Address": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址"
          }
        }
      }
    },
    "Address name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址名称"
          }
        }
      }
    },
    "Address name (optional)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址名称（可选）"
          }
        }
      }
    },
    "Addresses": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址"
          }
        }
      }
    },
    "Allow Accessibility…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许辅助功能…"
          }
        }
      }
    },
    "Allow Screen Recording…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许屏幕录制…"
          }
        }
      }
    },
    "Allow connections from the internet": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许来自互联网的连接"
          }
        }
      }
    },
    "Allow in System Settings…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置中允许…"
          }
        }
      }
    },
    "Allowed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已允许"
          }
        }
      }
    },
    "Allow…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许…"
          }
        }
      }
    },
    "An iPhone or iPad Needs Sill Updated": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 iPhone 或 iPad 需要更新 Sill"
          }
        }
      }
    },
    "Any device on your network (or nearby, with Direct Wireless Connection on) and any app on this Mac can see and control it without pairing. Connections are still encrypted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你网络中的任何设备（或打开无线直连时附近的任何设备）以及这台 Mac 上的任何 App 都无需配对即可查看并控制它。连接仍然是加密的。"
          }
        }
      }
    },
    "Anyone on the internet can now reach port %@ and try to connect. Sill turns away every device you haven’t paired. Turning this off doesn’t close the port on your router: remove the forward there too.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在互联网上的任何人都能访问端口 %@ 并尝试连接。Sill 会拒绝所有你未配对的设备。关闭此项不会关闭路由器上的端口：请同时在路由器上删除端口转发。"
          }
        }
      }
    },
    "Approve Sill in System Settings › Login Items": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置 › 登录项”中批准 Sill"
          }
        }
      }
    },
    "Approve in System Settings…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置中批准…"
          }
        }
      }
    },
    "Asking your router…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在询问路由器…"
          }
        }
      }
    },
    "Available": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用"
          }
        }
      }
    },
    "Available when Sill runs from its app bundle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sill 以 App 包形式运行时可用"
          }
        }
      }
    },
    "Available when Sill runs from its app bundle.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sill 以 App 包形式运行时可用。"
          }
        }
      }
    },
    "Away from home": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不在家时"
          }
        }
      }
    },
    "Away from home now: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前不在家：%@"
          }
        }
      }
    },
    "Balanced": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "均衡"
          }
        }
      }
    },
    "Beta. Devices play the sound of what you stream: all of the streamed window’s app, or every app for the Desktop. The Mac keeps playing it too. A connected iPhone or iPad can also turn this on or off from Sill’s settings there, and mute it for itself alone. Nothing is recorded.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试版。设备会播放所串流内容的声音：串流窗口所属 App 的全部声音，或串流桌面时所有 App 的声音。Mac 也会继续播放。已连接的 iPhone 或 iPad 也可以在其 Sill 设置中打开或关闭此项，并单独为自己静音。不会录制任何内容。"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Can’t pair while port %@ is in use.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口 %@ 被占用时无法配对。"
          }
        }
      }
    },
    "Can’t pair: remote access couldn’t start. Sill tries again every 30 seconds.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法配对：远程访问无法启动。Sill 每 30 秒重试一次。"
          }
        }
      }
    },
    "Can’t scan? Tap Enter Code Instead, and type:": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法扫描？轻点“改为输入配对码”，然后输入："
          }
        }
      }
    },
    "Change It in Sharing Settings…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在共享设置中更改…"
          }
        }
      }
    },
    "Change Port…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改端口…"
          }
        }
      }
    },
    "Change…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改…"
          }
        }
      }
    },
    "Check Now": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即检查"
          }
        }
      }
    },
    "Check for updates automatically": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动检查更新"
          }
        }
      }
    },
    "Checking…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查…"
          }
        }
      }
    },
    "Choose a port from 1024 to 65535.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择 1024 到 65535 之间的端口。"
          }
        }
      }
    },
    "Clear": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除"
          }
        }
      }
    },
    "Click Allow in System Settings: macOS asks about Sill once, then Privacy & Security opens, where you set Sill to Allow under Paste from Other Apps. Text a device sends with Paste still arrives.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按“在系统设置中允许”：macOS 会就 Sill 询问一次，然后打开“隐私与安全性”，请在“从其他 App 粘贴”中将 Sill 设为“允许”。设备通过“粘贴”发送的文本仍会送达。"
          }
        }
      }
    },
    "Click to show a code.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按以显示配对码。"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "Code": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对码"
          }
        }
      }
    },
    "Copied": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已复制"
          }
        }
      }
    },
    "Copies the command, to paste into Terminal": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制命令，以便粘贴到“终端”"
          }
        }
      }
    },
    "Copy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝"
          }
        }
      }
    },
    "Copy the %@ address": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝 %@ 地址"
          }
        }
      }
    },
    "Copy the IPv6 address": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝 IPv6 地址"
          }
        }
      }
    },
    "Copy the router’s internet address": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝路由器的互联网地址"
          }
        }
      }
    },
    "Copy this Mac’s address": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝这台 Mac 的地址"
          }
        }
      }
    },
    "Couldn’t check: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查：%@"
          }
        }
      }
    },
    "Couldn’t check: GitHub answered with an error (HTTP %lld).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查：GitHub 返回了错误（HTTP %lld）。"
          }
        }
      }
    },
    "Couldn’t check: GitHub didn’t answer within %lld seconds.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查：GitHub 在 %lld 秒内没有响应。"
          }
        }
      }
    },
    "Couldn’t check: GitHub has no release of Sill yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查：GitHub 上还没有 Sill 的发布版本。"
          }
        }
      }
    },
    "Couldn’t check: GitHub is limiting requests from this network. Try again after %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查：GitHub 正在限制来自此网络的请求。请在 %@ 之后再试。"
          }
        }
      }
    },
    "Couldn’t check: GitHub is limiting requests from this network. Try again in an hour.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查：GitHub 正在限制来自此网络的请求。请一小时后再试。"
          }
        }
      }
    },
    "Couldn’t check: GitHub’s answer wasn’t a release Sill understands.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查：GitHub 返回的不是 Sill 能识别的发布版本。"
          }
        }
      }
    },
    "Couldn’t check: this Mac isn’t connected to the internet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查：这台 Mac 未连接到互联网。"
          }
        }
      }
    },
    "Couldn’t start; trying again": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启动，正在重试"
          }
        }
      }
    },
    "Custom — %@ Mbps": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义 — %@ Mbps"
          }
        }
      }
    },
    "Cut": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪切"
          }
        }
      }
    },
    "Device": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备"
          }
        }
      }
    },
    "Devices": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备"
          }
        }
      }
    },
    "Devices Can’t Connect": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备无法连接"
          }
        }
      }
    },
    "Devices can connect but can’t see any windows.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备可以连接，但看不到任何窗口。"
          }
        }
      }
    },
    "Devices can watch but not click or type.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备可以观看，但无法点按或输入。"
          }
        }
      }
    },
    "Devices can’t connect: Sill couldn’t use its key in your keychain (%@). Quit Sill and open it again, and choose Always Allow if the keychain asks.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备无法连接：Sill 无法使用钥匙串中的密钥（%@）。请退出 Sill 后重新打开；如果钥匙串询问，请选择“始终允许”。"
          }
        }
      }
    },
    "Didn’t ask for this? Click Cancel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是你发起的？请点按“取消”。"
          }
        }
      }
    },
    "Direct": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直连"
          }
        }
      }
    },
    "Direct Wireless Connection": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无线直连"
          }
        }
      }
    },
    "Direct wireless connection": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无线直连"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "Each device asks for its own screen’s rate, up to this limit. Quality is per 60 fps; a 120 fps stream gets twice as much. %@ Changes apply at once: the current stream restarts for a moment.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每台设备会按自己屏幕的刷新率请求，但不超过此上限。画质以 60 fps 为基准；120 fps 的串流会得到两倍码率。%@ 更改会立即生效：当前串流会短暂重启。"
          }
        }
      }
    },
    "Each iPhone or iPad pairs once: over the USB cable by itself, or on Wi‑Fi with a code this Mac shows when the device asks. Everything devices send and receive is encrypted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每台 iPhone 或 iPad 只需配对一次：通过 USB 线自动配对，或在 Wi‑Fi 下由设备请求后输入这台 Mac 显示的配对码。设备收发的所有内容都经过加密。"
          }
        }
      }
    },
    "Edit": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑"
          }
        }
      }
    },
    "Efficient": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高效"
          }
        }
      }
    },
    "Extreme": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "极致"
          }
        }
      }
    },
    "Find": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找"
          }
        }
      }
    },
    "Find Next": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找下一个"
          }
        }
      }
    },
    "Find Previous": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找上一个"
          }
        }
      }
    },
    "Find…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找…"
          }
        }
      }
    },
    "Firewall": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防火墙"
          }
        }
      }
    },
    "Forward TCP port %@ on your router to this Mac (%@), and reserve that address for this Mac in the router’s settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在路由器上将 TCP 端口 %1$@ 转发到这台 Mac（%2$@），并在路由器设置中为这台 Mac 保留该地址。"
          }
        }
      }
    },
    "Frame Rate": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帧率"
          }
        }
      }
    },
    "Frame rate limit": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帧率上限"
          }
        }
      }
    },
    "General": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通用"
          }
        }
      }
    },
    "Hardware Encoder Busy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "硬件编码器繁忙"
          }
        }
      }
    },
    "Hardware Encoder Stuck": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "硬件编码器卡住"
          }
        }
      }
    },
    "High": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高"
          }
        }
      }
    },
    "IPv6": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "IPv6"
          }
        }
      }
    },
    "If your iPhone or iPad can’t find this Mac, allow Sill in Privacy & Security › Local Network.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 iPhone 或 iPad 找不到这台 Mac，请在“隐私与安全性 › 本地网络”中允许 Sill。"
          }
        }
      }
    },
    "If your router has a dynamic DNS name, enter it so your devices keep finding this Mac when your internet address changes. Add :port if the router forwards a different outside port.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你的路由器有动态 DNS 域名，请在此输入，这样互联网地址变化后设备仍能找到这台 Mac。如果路由器转发的外部端口不同，请加上“:端口”。"
          }
        }
      }
    },
    "In Sill on your iPhone or iPad, tap this Mac, or tap Add a Mac… when you’re away, then point it at this code.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 或 iPad 上的 Sill 中轻点这台 Mac（不在家时轻点“添加 Mac…”），然后对准这个配对码。"
          }
        }
      }
    },
    "Internet": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "互联网"
          }
        }
      }
    },
    "It paired by itself over the USB cable, and can connect over Wi‑Fi and nearby from now on too.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它已通过 USB 线自动配对，今后也可以通过 Wi‑Fi 和在附近连接。"
          }
        }
      }
    },
    "It tried to connect with an older Sill.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它尝试用旧版 Sill 连接。"
          }
        }
      }
    },
    "Last checked %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次检查：%@。"
          }
        }
      }
    },
    "Last window": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一个窗口"
          }
        }
      }
    },
    "Launch at Login": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时启动"
          }
        }
      }
    },
    "Launch at login": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时启动"
          }
        }
      }
    },
    "Lets Sill capture the windows you pick on your iPhone or iPad, and their sound when Send Audio is on. Nothing is recorded or saved; frames and sound go straight to your devices.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 Sill 捕获你在 iPhone 或 iPad 上选择的窗口，并在打开“传送声音”时捕获其声音。不会录制或保存任何内容；画面和声音直接发送到你的设备。"
          }
        }
      }
    },
    "Lets the iPhone and iPad you pair connect to this Mac from other networks: through a VPN such as Tailscale, or through a port you forward on your router. Sill turns away every device you haven’t paired, and encrypts everything the paired ones send and receive.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让你配对的 iPhone 和 iPad 从其他网络连接到这台 Mac：通过 Tailscale 等 VPN，或通过你在路由器上转发的端口。Sill 会拒绝所有未配对的设备，并加密已配对设备收发的所有内容。"
          }
        }
      }
    },
    "Lets your iPhone and iPad connect when they’re near this Mac, even without a shared Wi‑Fi network, the way AirDrop does. While it’s on, this Mac’s Wi‑Fi keeps stepping away from your network, so streaming over Wi‑Fi can stutter. Anyone nearby with Sill can find this Mac; only devices you paired can connect, unless Require pairing is off.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像隔空投送一样，即使没有共同的 Wi‑Fi 网络，iPhone 和 iPad 在这台 Mac 附近时也能连接。打开期间，这台 Mac 的 Wi‑Fi 会不断短暂离开你的网络，因此通过 Wi‑Fi 串流可能会卡顿。附近任何装有 Sill 的人都能发现这台 Mac；除非关闭了“需要配对”，否则只有你配对过的设备才能连接。"
          }
        }
      }
    },
    "Lets your iPhone or iPad click, scroll and type on this Mac, and lets Sill move and size the window it streams.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 iPhone 或 iPad 可以在这台 Mac 上点按、滚动和输入，并让 Sill 移动和调整所串流窗口的大小。"
          }
        }
      }
    },
    "Local Network": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地网络"
          }
        }
      }
    },
    "Low": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低"
          }
        }
      }
    },
    "Lower latency when the Mac is busy, at a softer picture.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 繁忙时延迟更低，但画面会稍软。"
          }
        }
      }
    },
    "Minimize": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最小化"
          }
        }
      }
    },
    "Name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称"
          }
        }
      }
    },
    "Needed to show your windows on your devices.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设备上显示你的窗口需要此权限。"
          }
        }
      }
    },
    "Needs Accessibility": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要辅助功能权限"
          }
        }
      }
    },
    "Needs Screen Recording": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要屏幕录制权限"
          }
        }
      }
    },
    "Needs Screen Recording and Accessibility": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要屏幕录制和辅助功能权限"
          }
        }
      }
    },
    "Needs attention": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要处理"
          }
        }
      }
    },
    "New Code": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新配对码"
          }
        }
      }
    },
    "No VPN is running on this Mac. Install one such as Tailscale on this Mac and on your iPhone or iPad, or allow connections from the internet below.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 上没有运行 VPN。请在这台 Mac 和你的 iPhone 或 iPad 上安装 Tailscale 之类的 VPN，或在下方允许来自互联网的连接。"
          }
        }
      }
    },
    "No paired devices yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有已配对的设备。"
          }
        }
      }
    },
    "No shared network needed; Wi‑Fi streams can stutter": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需共同网络；Wi‑Fi 串流可能会卡顿"
          }
        }
      }
    },
    "None": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无"
          }
        }
      }
    },
    "Not Visible on the Network": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在网络上不可见"
          }
        }
      }
    },
    "Not advertised (test pattern mode)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未广播（测试图案模式）"
          }
        }
      }
    },
    "Not advertised; test clients connect to port %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未广播；测试客户端连接到端口 %@。"
          }
        }
      }
    },
    "Not available on this version of macOS: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本 macOS 不可用：%@"
          }
        }
      }
    },
    "Not checked yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未检查。"
          }
        }
      }
    },
    "Not visible (the listener failed)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不可见（监听失败）"
          }
        }
      }
    },
    "Not yet (waiting for the network)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未（正在等待网络）"
          }
        }
      }
    },
    "Nothing is getting through": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据无法送达"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "Off": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关"
          }
        }
      }
    },
    "Off for this session: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次运行已关闭：%@"
          }
        }
      }
    },
    "On a Retina display, a quarter of the pixels to encode": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Retina 显示器上，只需编码四分之一的像素"
          }
        }
      }
    },
    "On · %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开 · %@"
          }
        }
      }
    },
    "On · no VPN on this Mac": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开 · 这台 Mac 上没有 VPN"
          }
        }
      }
    },
    "Once a day, Sill asks GitHub whether a newer version is out. GitHub sees this Mac’s IP address and which version of Sill it has; nothing else is sent. Sill never downloads or installs anything by itself: a new version opens its page on GitHub, where you download it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sill 每天询问一次 GitHub 是否有新版本。GitHub 会看到这台 Mac 的 IP 地址和 Sill 的版本号，不会发送其他任何信息。Sill 从不自行下载或安装任何东西：有新版本时会打开它在 GitHub 上的页面，由你自己下载。"
          }
        }
      }
    },
    "Only needed for a port forward on your router. A VPN is simpler and keeps this Mac off the open internet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在路由器上做端口转发时需要。使用 VPN 更简单，也能让这台 Mac 不暴露在公共互联网上。"
          }
        }
      }
    },
    "Open Energy Settings…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开节能设置…"
          }
        }
      }
    },
    "Open Local Network…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开本地网络设置…"
          }
        }
      }
    },
    "Open Privacy & Security…": {
      "localizations": {
