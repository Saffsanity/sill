        }
      }
    },
    "Sill %@ (%@). Free and open source.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sill %1$@（%2$@）。免费开源。"
          }
        }
      }
    },
    "Sill %@ Is Available…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sill %@ 已推出…"
          }
        }
      }
    },
    "Sill %@ is available.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sill %@ 已推出。"
          }
        }
      }
    },
    "Sill %@. The picture is unaffected.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sill %@。画面不受影响。"
          }
        }
      }
    },
    "Sill Couldn’t Start": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sill 无法启动"
          }
        }
      }
    },
    "Sill Log": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sill 日志"
          }
        }
      }
    },
    "Sill appears on your iPhone and iPad once this Mac is on Wi-Fi or Ethernet and Local Network access is allowed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 连上 Wi-Fi 或以太网并允许本地网络访问后，Sill 就会出现在你的 iPhone 和 iPad 上。"
          }
        }
      }
    },
    "Sill couldn’t use its key in your keychain.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sill 无法使用钥匙串中的密钥。"
          }
        }
      }
    },
    "Sill couldn’t use its key in your keychain. Quit Sill and open it again, and choose Always Allow if the keychain asks.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sill 无法使用钥匙串中的密钥。请退出 Sill 后重新打开；如果钥匙串询问，请选择“始终允许”。"
          }
        }
      }
    },
    "Sill doesn’t check for updates in test pattern mode.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试图案模式下 Sill 不检查更新。"
          }
        }
      }
    },
    "Sill is up to date.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sill 已是最新版本。"
          }
        }
      }
    },
    "Sill moves the window you pick onto an invisible display made for your device, so it keeps updating when other windows cover it and text is drawn at your device’s scale. The window leaves this screen while it streams and comes back when you stop streaming or quit Sill.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sill 会把你选择的窗口移到一块为你的设备专门创建的隐形显示器上，这样即使被其他窗口遮挡它也会持续更新，文字也会按设备的缩放比例绘制。串流期间窗口会离开这块屏幕，停止串流或退出 Sill 后会回来。"
          }
        }
      }
    },
    "Sill streams at these while every connected device is away from home, through a VPN or over the internet, so a slow connection never starts at your home quality. A device away from home changes these, and never your Quality and Resolution above.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当所有已连接设备都不在家（通过 VPN 或互联网连接）时，Sill 会按这些设置串流，避免慢速连接一开始就用家中的画质。不在家的设备只会更改这些设置，不会更改上方的画质和分辨率。"
          }
        }
      }
    },
    "Sill streams at these while every connected device is away from home, through a VPN or over the internet, so a slow connection never starts at your home quality. A device away from home changes these, and never your Quality and Resolution above. Streaming at these now.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当所有已连接设备都不在家（通过 VPN 或互联网连接）时，Sill 会按这些设置串流，避免慢速连接一开始就用家中的画质。不在家的设备只会更改这些设置，不会更改上方的画质和分辨率。当前正按这些设置串流。"
          }
        }
      }
    },
    "Sill — %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sill — %@"
          }
        }
      }
    },
