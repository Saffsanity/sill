            "state": "translated",
            "value": "home.example.net"
          }
        }
      }
    },
    "just now": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刚刚"
          }
        }
      }
    },
    "last connected %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次连接于%@"
          }
        }
      }
    },
    "last connected %@ %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次连接于%1$@，%2$@"
          }
        }
      }
    },
    "macOS asks before Sill reads the clipboard, so what you copy here stays on this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sill 读取剪贴板前 macOS 会先询问，因此你在这里拷贝的内容会留在这台 Mac 上。"
          }
        }
      }
    },
    "macOS doesn’t let Sill read the clipboard, so what you copy here stays on this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 不允许 Sill 读取剪贴板，因此你在这里拷贝的内容会留在这台 Mac 上。"
          }
        }
      }
    },
    "nearby": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附近"
          }
        }
      }
    },
    "no identity": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有身份"
          }
        }
      }
    },
