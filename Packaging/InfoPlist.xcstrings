{
  "sourceLanguage": "en",
  "strings": {
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sill makes this Mac visible to your iPhone and iPad on the same network so they can stream its windows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sill 让同一网络上的 iPhone 和 iPad 能够发现这台 Mac，以便串流它的窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sill 讓同一網路上的 iPhone 和 iPad 能夠找到這部 Mac，以便串流其視窗。"
          }
        }
      }
    },
    "NSHumanReadableCopyright": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sill is free and open source."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sill 免费且开源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sill 免費且開放原始碼。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
