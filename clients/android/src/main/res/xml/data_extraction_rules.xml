<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves this device: the device key (sealed by a Keystore key that does not leave it either)
     and the saved Macs are this install's, as on the iPad (Keychain, this device only). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
