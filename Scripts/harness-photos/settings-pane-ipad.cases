# Settings as a whole-screen pane (docs/settings-pane-plan.md) on the agents' iPad (iPad Pro 13-inch (M5), iOS
# 27.0, upright: a sideways screen is drawn a quarter turn round): either way round, an iPad mini's, half of a
# Split View, a Slide Over's width, scrolled to the end, large type, right to left; and the stream screen without
# it, which must be main's pixel for pixel.
#   Scripts/harness-photos.sh Scripts/harness-photos/settings-pane-ipad.cases --device ipad --baseline origin/main
ipad-upright               -SillLayout 1032x1376 -SillSafeArea 24,0,20,0 -SillSettings 1
ipad-upright-end           -SillLayout 1032x1376 -SillSafeArea 24,0,20,0 -SillSettings 1 -SillSettingsEnd 1
ipad-upright-stream        -SillLayout 1032x1376 -SillSafeArea 24,0,20,0
ipad-side                  -SillLayout 1376x1032 -SillSafeArea 24,0,20,0 -SillSettings 1
ipad-side-end              -SillLayout 1376x1032 -SillSafeArea 24,0,20,0 -SillSettings 1 -SillSettingsEnd 1
ipad-side-ax3              -SillLayout 1376x1032 -SillSafeArea 24,0,20,0 -SillSettings 1 -UIPreferredContentSizeCategoryName UICTContentSizeCategoryAccessibilityXL
ipad-side-rtl              -SillLayout 1376x1032 -SillSafeArea 24,0,20,0 -SillSettings 1 -AppleTextDirection YES -NSForceRightToLeftWritingDirection YES
ipad-side-stream           -SillLayout 1376x1032 -SillSafeArea 24,0,20,0
ipad-mini-upright          -SillLayout 744x1133 -SillSafeArea 24,0,20,0 -SillSettings 1
ipad-split-half            -SillLayout 683x1032 -SillSafeArea 24,0,20,0 -SillSettings 1
ipad-slide-over            -SillLayout 375x1000 -SillSafeArea 24,0,20,0 -SillSettings 1
ipad-slide-over-end        -SillLayout 375x1000 -SillSafeArea 24,0,20,0 -SillSettings 1 -SillSettingsEnd 1
