# Settings as a whole-screen pane (docs/settings-pane-plan.md) on the agents' Duo (iOS 27.1), which also stands in
# for an iPhone (the agents' pair has no plain one: an iPhone's screen is drawn inside the Duo's): every pose, an
# iPhone upright and on its side, scrolled to the end, a long list, large type, right to left; and the stream
# screen without it, which must be main's pixel for pixel. Grouped by pose, so the Duo folds as few times as can be.
# `-area`: each scroll view outlined, where a drag scrolls (out to the screen's edges, the strips beside it included).
#   Scripts/harness-photos.sh Scripts/harness-photos/settings-pane-duo.cases --baseline origin/main
# Open flat, upright (the default pose): the inner display, and an iPhone's 393x852 upright.
flat-portrait              -SillLayout 669x951 -SillHinge flat -SillSettings 1
flat-portrait-end          -SillLayout 669x951 -SillHinge flat -SillSettings 1 -SillSettingsEnd 1
flat-portrait-long         -SillLayout 669x951 -SillHinge flat -SillSettings 1 -SillSettingsCase linkbehind -SillPiPSupported 1 -SillClipboardNote sent
flat-portrait-stream       -SillLayout 669x951 -SillHinge flat
phone-upright              -SillLayout 393x852 -SillSafeArea 59,0,34,0 -SillSettings 1
phone-upright-end          -SillLayout 393x852 -SillSafeArea 59,0,34,0 -SillSettings 1 -SillSettingsEnd 1
phone-upright-ax3          -SillLayout 393x852 -SillSafeArea 59,0,34,0 -SillSettings 1 -UIPreferredContentSizeCategoryName UICTContentSizeCategoryAccessibilityXL
phone-upright-stream       -SillLayout 393x852 -SillSafeArea 59,0,34,0
# The laptop pose.
laptop                     -SillLayout 669x951 -SillHinge half -SillSettings 1 --pose=laptop
laptop-end                 -SillLayout 669x951 -SillHinge half -SillSettings 1 -SillSettingsEnd 1 --pose=laptop
laptop-ax3                 -SillLayout 669x951 -SillHinge half -SillSettings 1 -UIPreferredContentSizeCategoryName UICTContentSizeCategoryAccessibilityXL --pose=laptop
laptop-area                -SillLayout 669x951 -SillHinge half -SillSettings 1 -SillSettingsScrollArea 1 --pose=laptop
laptop-stream              -SillLayout 669x951 -SillHinge half --pose=laptop
# The book pose.
book                       -SillLayout 951x669 -SillHinge half -SillSettings 1 --pose=book
book-end                   -SillLayout 951x669 -SillHinge half -SillSettings 1 -SillSettingsEnd 1 --pose=book
book-rtl                   -SillLayout 951x669 -SillHinge half -SillSettings 1 -AppleTextDirection YES -NSForceRightToLeftWritingDirection YES --pose=book
book-area                  -SillLayout 951x669 -SillHinge half -SillSettings 1 -SillSettingsScrollArea 1 --pose=book
book-stream                -SillLayout 951x669 -SillHinge half --pose=book
# Open flat, sideways: the inner display, and an iPhone on its side, one column since 2026-11-23 (how many rows show
# between the header and Disconnect): an iPhone 15 Pro's 852x393, an SE's 667x375 (no home indicator) and 568x320
# with Display Zoom, an 812x375 with a home indicator (the X family, the 13 mini: the least room at 375 pt), and a
# Pro Max's 956x440, the tallest (wider than the inner display's 951: drawn at 0.99, laid out at its own size).
flat-landscape             -SillLayout 951x669 -SillHinge flat -SillSettings 1 --pose=flat-landscape
flat-landscape-long        -SillLayout 951x669 -SillHinge flat -SillSettings 1 -SillSettingsCase linkbehind -SillPiPSupported 1 -SillClipboardNote sent --pose=flat-landscape
phone-side                 -SillLayout 852x393 -SillSafeArea 0,59,21,59 -SillSettings 1 --pose=flat-landscape
phone-side-end             -SillLayout 852x393 -SillSafeArea 0,59,21,59 -SillSettings 1 -SillSettingsEnd 1 --pose=flat-landscape
phone-side-ax3             -SillLayout 852x393 -SillSafeArea 0,59,21,59 -SillSettings 1 -UIPreferredContentSizeCategoryName UICTContentSizeCategoryAccessibilityXL --pose=flat-landscape
phone-side-area            -SillLayout 852x393 -SillSafeArea 0,59,21,59 -SillSettings 1 -SillSettingsScrollArea 1 --pose=flat-landscape
phone-se-side              -SillLayout 667x375 -SillSettings 1 --pose=flat-landscape
phone-se-zoom-side         -SillLayout 568x320 -SillSettings 1 --pose=flat-landscape
phone-mini-side            -SillLayout 812x375 -SillSafeArea 0,44,21,44 -SillSettings 1 --pose=flat-landscape
phone-max-side             -SillLayout 956x440 -SillSafeArea 0,62,21,62 -SillSettings 1 --pose=flat-landscape
# Closed: the cover, upright and on its side.
cover                      -SillLayout 466x678 -SillHinge closed -SillSettings 1 --pose=closed-upright
cover-end                  -SillLayout 466x678 -SillHinge closed -SillSettings 1 -SillSettingsEnd 1 --pose=closed-upright
cover-ax3                  -SillLayout 466x678 -SillHinge closed -SillSettings 1 -UIPreferredContentSizeCategoryName UICTContentSizeCategoryAccessibilityXL --pose=closed-upright
cover-stream               -SillLayout 466x678 -SillHinge closed --pose=closed-upright
cover-side                 -SillLayout 678x466 -SillHinge closed -SillSettings 1 --pose=closed-side
cover-side-area            -SillLayout 678x466 -SillHinge closed -SillSettings 1 -SillSettingsScrollArea 1 --pose=closed-side
